--swiftversion 6.0
--indent 4
--maxwidth 140
--wraparguments before-first
--wrapparameters before-first
--wrapcollections before-first
--self remove
--stripunusedargs closure-only
--disable redundantSendable,redundantMemberwiseInit,preferKeyPath,wrapMultilineStatementBraces,blankLinesAtStartOfScope,blankLinesAtEndOfScope,unusedPrivateDeclarations,trailingClosures,redundantProperty,docComments,preferSwiftTesting,noForceUnwrapInTests,noForceTryInTests,redundantEquatable,swiftTestingTestCaseNames,environmentEntry,redundantViewBuilder,blockComments,hoistPatternLet
--exclude .build,Packages/SwiftmailCore/.build
